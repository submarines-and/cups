#include <font.defs>
#include <media.defs>
#include <label.h>

#media "w50h50/Label 50mmx50mm" 50mm 50mm
#media "w50h75/Label 50mmx75mm" 50mm 75mm
#media "w50h100/Label 50mmx100mm" 50mm 100mm
#media "w50h125/Label 50mmx125mm" 50mm 125mm
#media "w50h150/Label 50mmx150mm" 50mm 150mm
{
  Manufacturer "Phomemo"
  ModelName "M02 Pro"
  PCFileName "phomemo-m02pro.ppd"
  Version 1.0
  Attribute "NickName" "" "Phomemo M02 Pro"
  DriverType label
  ColorDevice No
  Attribute "cupsSNMPSupplies" "" "false"
  HWMargins 0 0 0 0

  Filter "application/vnd.cups-raster 100 rastertopm02"
  *Resolution - 8 0 0 0 300dpi
  ColorModel Gray/Grayscale w chunky 0

  MediaSize "w50h50"
  MediaSize "w50h75"
  MediaSize "w50h100"
  MediaSize "w50h125"
  MediaSize "w50h150"

  VariablePaperSize No
  MinSize 0.00 0.00
  MaxSize 0.00 0.00
}
