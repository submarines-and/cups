//
// Driver info file for Phomemo M02
//
// https://www.cups.org/doc/ref-ppdcfile.html
//
// Paper heights and purpose:
// 50 Square
// 65 Iphone portrait photo
// 70 A6 postcard
// 100 Text (Rotated 90deg)
//

#include <font.defs>
#include <media.defs>
#include <label.h>

#media "w50h50/Label 50mmx50mm" 50mm 50mm
#media "w50h65/Label 50mmx65mm" 50mm 65mm
#media "w50h70/Label 50mmx70mm" 50mm 70mm
#media "w50h100/Label 50mmx100mm" 50mm 100mm
{
  Manufacturer "Phomemo"
  ModelName "M02 Pro"
  PCFileName "phomemo-m02pro.ppd"
  Version 1.0
  Attribute "NickName" "" "Phomemo M02 Pro"
  DriverType label
  ColorDevice No
  Attribute "cupsSNMPSupplies" "" "false"
  HWMargins 0 0 0 0

  Filter "application/vnd.cups-raster 100 rastertopm02"
  *Resolution - 8 0 0 0 300dpi
  ColorModel Gray/Grayscale w chunky 0

  MediaSize "w50h50"
  MediaSize "w50h65"
  MediaSize "w50h70"
  MediaSize "w50h100"

  VariablePaperSize No
  MinSize 0.00 0.00
  MaxSize 0.00 0.00
}
